     #[test]
+    fn unilateral_abandon_diagnostic_pins_unordered_dedup_boundary() {
+        let mut send = SendChannelReliable::new(0, Duration::from_millis(100), 8);
+        let mut recv = ReceiveChannelReliable::new(8, false);
+        let mut sequence = 0;
+        let mut available_bytes = u64::MAX;
+
+        send.send_message(Bytes::from_static(b"missing0")).unwrap();
+        let lost_packets = send.get_packets_to_send(&mut sequence, &mut available_bytes, Duration::ZERO);
+        assert_eq!(lost_packets.len(), 1);
+        drop(lost_packets);
+
+        // Diagnostic only: model the proposed sender-only deletion after emission.
+        let Some(UnackedMessage::Small { message, .. }) = send.unacked_messages.remove(&0) else {
+            panic!("expected the emitted small message");
+        };
+        send.memory_usage_bytes -= message.len();
+
+        for message_id in 1..=1024 {
+            send.send_message(Bytes::from_static(b"received")).unwrap();
+            let mut available_bytes = u64::MAX;
+            let packets = send.get_packets_to_send(&mut sequence, &mut available_bytes, Duration::from_millis(message_id * 100));
+            assert_eq!(packets.len(), 1);
+            for packet in packets {
+                let Packet::SmallReliable { messages, .. } = packet else {
+                    panic!("expected small reliable packet");
+                };
+                for (received_id, message) in messages {
+                    assert_eq!(received_id, message_id);
+                    recv.process_message(message, received_id).unwrap();
+                    send.process_message_ack(received_id);
+                }
+            }
+            assert_eq!(recv.receive_message().unwrap().as_ref(), b"received");
+            assert!(recv.receive_message().is_none());
+            assert_eq!(recv.memory_usage_bytes, 0);
+        }
+
+        let ReliableOrder::Unordered { received_messages, .. } = &recv.reliable_order else {
+            panic!("expected reliable unordered receiver");
+        };
+        assert_eq!(recv.oldest_pending_message_id, 0);
+        assert_eq!(received_messages.len(), 1024);
+        assert_eq!(send.available_memory(), 8);
+        println!(
+            "unilateral_abandon_dedup: simulated_ms=102400 boundary={} tracked_ids={} payload_bytes={} payload_limit={} sender_available={}",
+            recv.oldest_pending_message_id,
+            received_messages.len(),
+            recv.memory_usage_bytes,
+            recv.max_memory_usage_bytes,
+            send.available_memory(),
+        );
+    }
