+    #[test]
+    fn unilateral_abandon_diagnostic_strands_partial_receiver_allocation() {
+        const PAYLOAD_BYTES: usize = 29_216;
+        const RESERVED_BYTES: usize = PAYLOAD_BYTES.div_ceil(SLICE_SIZE) * SLICE_SIZE;
+        const CHANNEL_LIMIT: usize = RESERVED_BYTES + 8;
+        let mut send = SendChannelReliable::new(0, Duration::from_millis(100), CHANNEL_LIMIT);
+        let mut recv = ReceiveChannelReliable::new(CHANNEL_LIMIT, false);
+        let mut sequence = 0;
+        let mut available_bytes = SLICE_SIZE as u64;
+
+        send.send_message(vec![7; PAYLOAD_BYTES].into()).unwrap();
+        let packets = send.get_packets_to_send(&mut sequence, &mut available_bytes, Duration::ZERO);
+        assert_eq!(packets.len(), 1);
+        for packet in packets {
+            let Packet::ReliableSlice { slice, .. } = packet else {
+                panic!("expected first slice of the large message");
+            };
+            assert_eq!(slice.message_id, 0);
+            assert_eq!(slice.slice_index, 0);
+            recv.process_slice(slice).unwrap();
+        }
+        assert_eq!(recv.memory_usage_bytes, RESERVED_BYTES);
+
+        // Diagnostic only: stop all future slices and free the sender's payload.
+        let Some(UnackedMessage::Sliced { message, .. }) = send.unacked_messages.remove(&0) else {
+            panic!("expected partially emitted sliced message");
+        };
+        send.memory_usage_bytes -= message.len();
+
+        for message_id in 1..=600 {
+            send.send_message(Bytes::from_static(b"received")).unwrap();
+            let mut available_bytes = u64::MAX;
+            let packets = send.get_packets_to_send(&mut sequence, &mut available_bytes, Duration::from_millis(message_id * 100));
+            assert_eq!(packets.len(), 1);
+            for packet in packets {
+                let Packet::SmallReliable { messages, .. } = packet else {
+                    panic!("expected small reliable packet");
+                };
+                for (received_id, message) in messages {
+                    assert_eq!(received_id, message_id);
+                    recv.process_message(message, received_id).unwrap();
+                    send.process_message_ack(received_id);
+                }
+            }
+            assert_eq!(recv.receive_message().unwrap().as_ref(), b"received");
+            assert_eq!(recv.memory_usage_bytes, RESERVED_BYTES);
+        }
+
+        assert_eq!(recv.slices.len(), 1);
+        assert!(recv.slices.contains_key(&0));
+        assert_eq!(recv.oldest_pending_message_id, 0);
+        assert_eq!(send.available_memory(), CHANNEL_LIMIT);
+
+        send.send_message(vec![9; PAYLOAD_BYTES].into()).unwrap();
+        let mut available_bytes = SLICE_SIZE as u64;
+        let packets = send.get_packets_to_send(&mut sequence, &mut available_bytes, Duration::from_secs(61));
+        assert_eq!(packets.len(), 1);
+        for packet in packets {
+            let Packet::ReliableSlice { slice, .. } = packet else {
+                panic!("expected replacement large-message slice");
+            };
+            assert_eq!(slice.message_id, 601);
+            assert_eq!(recv.process_slice(slice), Err(ChannelError::ReliableChannelMaxMemoryReached));
+        }
+        println!(
+            "unilateral_abandon_partial: simulated_ms=61000 partial_messages={} reserved_bytes={} payload_limit={} receiver_available={} next_large_message=ReliableChannelMaxMemoryReached",
+            recv.slices.len(),
+            recv.memory_usage_bytes,
+            recv.max_memory_usage_bytes,
+            recv.max_memory_usage_bytes - recv.memory_usage_bytes,
+        );
+    }
